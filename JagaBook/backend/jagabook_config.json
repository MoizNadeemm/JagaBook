    "eject": "react-scripts eject",
    "lint": "eslint src/"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}

// ============================================
// FILE: backend/.env.example
// Environment Variables Template
// ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/jagabook

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=7d

# Email Service (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@jagabook.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Payment Gateway (Demo Mode)
PAYMENT_API_KEY=demo_payment_api_key
PAYMENT_SECRET=demo_payment_secret_key
PAYMENT_WEBHOOK_SECRET=demo_webhook_secret

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
// FILE: frontend/.env.example
// Frontend Environment Variables
// ============================================

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Application Info
REACT_APP_NAME=JagaBook
REACT_APP_VERSION=1.0.0

# Google Maps (Optional)
REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Analytics (Optional)
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X

